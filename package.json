{
	"name": "client",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build:dev": "next build && next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"reinstall": "rm -rf node_modules pnpm-lock.yaml .next && pnpm install && pnpm prune"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@tanstack/react-query": "^5.90.20",
		"@tanstack/react-query-devtools": "^5.91.3",
		"axios": "^1.13.4",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"next": "16.2.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.71.1",
		"tailwind-merge": "^3.4.0",
		"yup": "^1.7.1",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@tanstack/eslint-plugin-query": "^5.91.4",
		"@types/node": "^20.19.33",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"Transform": "AWS::Serverless-2016-10-31",
	"Resources": {
		"Api": {
			"Type": "AWS::Serverless::Api",
			"Properties": {
				"Name": {
					"Fn::Sub": [
						"${ResourceName} From Stack ${AWS::StackName}",
						{
							"ResourceName": "Api"
						}
					]
				},
				"StageName": "Prod",
				"DefinitionBody": {
					"openapi": "3.0",
					"info": {},
					"paths": {
						"/": {
							"get": {
								"responses": {}
							}
						}
					}
				},
				"EndpointConfiguration": "REGIONAL",
				"TracingEnabled": true
			}
		}
	}
}